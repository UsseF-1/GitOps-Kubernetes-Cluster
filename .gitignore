# ============================
# Terraform
# ============================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# ============================
# Kubernetes / Helm
# ============================
**/kubeconfig*
**/kubeconfig.txt
**/urls.txt
**/output.yaml
**/helm-chart/**/*.tgz
**/helm-chart/**/charts/
**/helm-chart/**/Chart.lock

# ============================
# Node.js (result service)
# ============================
**/node_modules/
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log
**/package-lock.json
**/yarn.lock

# ============================
# Python (vote service)
# ============================
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/venv/
**/env/
**/dist/
**/build/
**/*.egg-info/

# ============================
# .NET (worker service)
# ============================
**/bin/
**/obj/
**/*.sln
**/*.suo
**/*.user
**/*.userprefs
**/mono_crash.*
**/TestResults/

# ============================
# Docker
# ============================
**/.dockerignore
**/docker-compose.override.yml
**/.env

# ============================
# IDE / Editor files
# ============================
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*.bak
**/*.tmp

# ============================
# OS / System files
# ============================
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.log

# ============================
# Ansible / Monitoring (placeholder)
# ============================
**/ansible/*.retry
**/ansible/inventory_*
**/monitoring/*.db
**/monitoring/*.log

# ============================
